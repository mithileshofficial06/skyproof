# Public settings for the SkyProof website (all optional; defaults shown).
# Copy to .env.local for local runs, or set them in your host's dashboard (e.g. Vercel).

# Officer WebSocket for the Live page (the flight computer running `pnpm officer`)
NEXT_PUBLIC_OFFICER_WS=ws://localhost:8787
# Evidence + claims-desk server (`pnpm evidence`)
NEXT_PUBLIC_EVIDENCE_URL=http://localhost:8788
# SkyProofEscrow on Arc Testnet
NEXT_PUBLIC_ARC_ESCROW=0x10daa2dbded35f0056be1dbdbee908a12e4644d8
