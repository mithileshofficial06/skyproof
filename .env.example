# Copy to .env and fill in. NEVER commit .env.

# ---------- 0G ----------
# Private Computer (AI brain) - from pc.0g.ai
ZG_PC_API_KEY=
ZG_PC_BASE_URL=            # OpenAI-compatible endpoint from pc.0g.ai docs
ZG_VISION_MODEL=           # verified vision model name (ask 0G booth)
# Galileo testnet (verify in 0G docs)
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16602
ZG_STORAGE_INDEXER=        # 0G Storage indexer URL from docs

# ---------- Wallets (testnet only) ----------
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
VICTIM_PRIVATE_KEY=

# ---------- Arc ----------
ARC_RPC_URL=               # Arc testnet RPC (from Arc docs)
ARC_CHAIN_ID=
ARC_STUDIO_PROJECT_URL=
ARC_ESCROW_ADDRESS=        # SkyProofEscrow, deployed from Arc Studio

# ---------- Chainlink CRE ----------
WEATHER_API=open-meteo     # no key needed

# Website "Start flight" (officer): daily cap; optional passcode; DEMO_START=off disables it
DEMO_MAX_FLIGHTS=30
DEMO_PASSCODE=
DEMO_START=on
